OPENAI_API_KEY=sk-proj
NVIDIA_API_KEY=
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
#NVIDIA_API_KEY_4=
HF_TOKEN=
# Optional. Paste a Tavily API key here (free tier: 1000 searches/month) to
# upgrade the Research Agent's web search quality. If left blank, the
# Research Agent falls back to DuckDuckGo (no key required) and then to
# curated fixtures. Get a key at https://tavily.com/
TAVILY_API_KEY=

# /planner slash-command. The planner-first pipeline (src.core.pipeline)
# is reachable in code via "/planner <query>" but the panel-slice
# factories (us_stock, indian_stock, portfolio, panel) aren't shipped
# yet — any /planner query that needs them crashes. Default: 0 (hidden
# from end users). Set to 1 to expose; useful for internal demos of
# the new architecture.
FINAI_PLANNER_PREFIX=0

# Verbose dev-trace classification card. Default: 0 (hidden in
# production). Set to 1 to always surface the routing card; or use
# "/trace <query>" on a single message for one-shot diagnostics.
FINAI_VERBOSE_TRACE=0

# CORS allow-list (comma-separated). REQUIRED in production — set to your real
# frontend origin(s), e.g. https://app.example.com. Defaults to localhost dev
# origins. Never use "*" with a credentialed API.
# FINAI_ALLOWED_ORIGINS=https://your-frontend.example.com

# Equity warehouse (sibling `equity-pipeline` project). When set, the
# Indian-stock worker backs get_quote with exchange-sourced NSE bhavcopy EOD
# data from this PostgreSQL analytics layer (NIFTY-50 universe); unset =
# fall back to yfinance/fixtures. Points at equity-pipeline's DATABASE_URL.
# WAREHOUSE_DATABASE_URL=postgresql://equity_user:equity_pass@localhost:5433/equity_db

# Quant backtesting (sibling `automated-trading` project). When BOTH are set,
# FinAI spawns that repo's READ-ONLY quant MCP server (in its own Python 3.14
# venv) and exposes a quant_agent that can list/backtest NIFTY F&O strategy
# templates. No execution surface is exposed. Unset = quant agent hidden.
# QUANT_MCP_PYTHON=/abs/path/to/automated-trading/.venv/bin/python
# QUANT_MCP_CWD=/abs/path/to/automated-trading

# Persistent per-user memory (SQLite). Authenticated users get a durable
# profile (risk tolerance / horizon / goals) + recent topics that personalise
# planning and every agent. Defaults to data/finai_memory.db; the demo and
# anonymous identities are never stored. Override the path here if needed.
# FINAI_MEMORY_DB=/abs/path/to/finai_memory.db

# Event-driven portfolio alerts store (SQLite). A scheduler can run
# `python -m src.core.alerts <user_id>` to scan holdings for concentration /
# large-move alerts. Defaults to data/finai_alerts.db.
# FINAI_ALERTS_DB=/abs/path/to/finai_alerts.db